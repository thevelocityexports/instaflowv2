{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api/webhooks/$1"
    },
    {
      "source": "/webhook/(.*)",
      "destination": "/api/webhooks/$1"
    },
    {
      "source": "/((?!api/|webhooks/|webhook/).*)",
      "destination": "/index.html"
    }
  ]
}
